# job-hound environment template.
#
#   cp .env.example .env    then edit .env and fill in real values.
#
# .env, *.env and .env.* are gitignored. Never commit a filled-in copy, and
# never put a real API key, bearer token or webhook URL in this file.
#
# Load it however you prefer, for example:
#   set -a; . ./.env; set +a
#
# Only two variables normally matter to get started: ANTHROPIC_API_KEY (for the
# stages that call a model) and JOB_DB (where the database lives). Everything
# else has a working default and is listed here so you know it exists.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# API key for the model calls: the Fit Gate, document drafting, and the
# optional LLM tier of `refine`. Read from the environment at call time and
# never written to a file in the repo. Leave it unset and those stages fail
# closed with a clear message; the free, deterministic stages (scan, list,
# prune, refine --no-llm) still work without it.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Path to the SQLite system of record. Required unless a jobs.db already
# exists in the working directory. There is no per-user default and nothing
# invents one, deliberately: a second, divergent database is a data-loss bug,
# not a convenience.
JOB_DB=~/job-hound/jobs.db


# ---------------------------------------------------------------------------
# Paths and data files
# ---------------------------------------------------------------------------

# Optional. Root directory for generated application packages, one folder per
# application. Default: ~/job-applications
JOB_APPS_DIR=~/job-applications

# Optional. Scan config: the target companies, their ATS slugs, and the title
# and location filters. Default: ./companies.yaml
JOB_CONFIG=./companies.yaml

# Optional. Your master resume, the only source the generator may draw
# experience from, and the home of the do_not_claim ledger.
# Default: ./master_resume.yaml
JOB_MASTER=./master_resume.yaml

# Optional. Fit profile used by the deterministic ranker (targets, salary
# floor, location rules). Default: ./profile.yaml
JOB_PROFILE=./profile.yaml

# Optional. The wide net's query document: prose in the shape of a posting you
# want, embedded into the same vector space as the corpus. Says what you WANT,
# where master_resume.yaml says what you HAVE. Default: ./ideal-jd.md
JOB_IDEAL_JD=./ideal-jd.md

# Optional. Where job_monitor.py keeps its seen-postings state between runs, so
# a scan can report only NEW matches. Default: a per-user data directory
# (XDG_DATA_HOME on Linux, APPDATA on Windows, home otherwise), under
# job-monitor/
JOB_MONITOR_STATE=~/.local/share/job-monitor/state.json

# Optional. Spool directory the lead inbox writes submissions into, drained by
# job_ingest.py. Default: a per-user spool directory under your home.
JOB_INBOX_DIR=~/.job-hound/job-inbox

# Optional. Cache for the wide net's manifest, centroids and downloaded group
# files. One build is roughly 37MB and discover() keeps the two most recent.
# Default: an openjobs-cache/ directory beside jobs.db
JOB_OPENJOBS_CACHE=~/job-hound/openjobs-cache

# Optional. Base directory for logs. Used for the LLM usage log and by
# bin/daily.sh. Default: ~/logs
LOG_DIR=~/logs

# Optional. Append-only log of model usage: component, model, token counts and
# cost. Never records keys or prompt contents. Set to "off" (also 0, false, no)
# to disable. Default: LOG_DIR (or ~/logs) plus /job-hound/llm-usage.log
JOB_LLM_USAGE_LOG=~/logs/job-hound/llm-usage.log


# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------
# Precedence for each call site: the component variable, then JOB_MODEL, then
# the component default, then the provider default.

# Optional. Model for the cheap lead ranker. Default: claude-haiku-4-5
JOB_FIT_MODEL=claude-haiku-4-5

# Optional. Model for the Fit Gate. This decision blocks or releases every
# artifact, so it defaults to the strongest model. Default: claude-opus-4-8
JOB_GATE_MODEL=claude-opus-4-8

# Optional. Model for resume and cover-letter drafting.
# Default: claude-opus-4-8
JOB_DRAFT_MODEL=claude-opus-4-8

# Optional. Global model override for every call site at once. The component
# variables above win wherever both are set. Unset by default.
JOB_MODEL=

# Optional. Which provider to route LLM calls through. "anthropic" (default) or
# "kimi" (Moonshot's Anthropic-compatible endpoint). Manual switch only;
# nothing auto-fails-over. Default: anthropic
JOB_PROVIDER=anthropic

# Optional. API key for the kimi provider, read only when JOB_PROVIDER=kimi.
MOONSHOT_API_KEY=

# Optional. Override the provider's base URL. For pointing at a compatible
# gateway or a local mock. Default: the active provider's registered URL.
JOB_LLM_BASE_URL=

# Optional. Override the API key for whichever provider is active, instead of
# using that provider's own key variable. Default: unset.
JOB_LLM_API_KEY=

# Optional. Whole seconds of HTTP timeout for model calls, overriding the
# per-provider default (180s for anthropic, 600s for the slower kimi endpoint).
# A non-numeric value is a hard error naming this variable.
JOB_LLM_TIMEOUT=

# Optional. Set to "off" (also 0, false, no) to disable the gate's semantic
# screen, the pass that matches do_not_claim entries by meaning as well as by
# substring. Default: on
JOB_GATE_SCREEN=on


# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

# Optional. Set to "off" to skip PDF generation and write DOCX only. PDFs need
# LibreOffice (soffice) on PATH. Default: PDFs are generated when soffice is
# available.
JOB_PDF=

# Optional. Contact address advertised in the outbound User-Agent when the
# scanner reads public ATS endpoints, so a board operator who wants to complain
# has somewhere to write. Set this to a real address you read.
# Default: job-monitor@example.invalid
JOB_CONTACT_EMAIL=you@example.com


# ---------------------------------------------------------------------------
# Wide-net discovery (the open-jobs corpus)
# ---------------------------------------------------------------------------

# Optional. Corpus endpoint serving the manifest, centroids, group files and
# the /embed call. Default: the public open-jobs worker.
JOB_OPENJOBS_URL=

# Optional. Set to 0 to switch the wide net off in bin/daily.sh without
# deleting the stage. Default: 1
OPENJOBS_ENABLED=1

# Optional. How many NEW leads the wide net may ingest per run. This is a
# budget on rows written to the database, so 0 means zero, not unlimited.
# Default: 15
OPENJOBS_TOP=15

# Optional. Wall-clock cap on the wide net in bin/daily.sh, as a `timeout`
# duration. Bounds how late a hung corpus request can make the digest.
# Default: 10m
OPENJOBS_TIMEOUT=10m


# ---------------------------------------------------------------------------
# Weekly liveness sweep (bin/daily.sh)
# ---------------------------------------------------------------------------

# Optional. Set to 0 to switch the weekly `prune --apply` sweep off without
# deleting it. Default: 1
PRUNE_ENABLED=1

# Optional. Which day the sweep runs, as `date +%u` (1=Monday .. 7=Sunday).
# Weekly rather than daily because postings do not die fast enough to justify
# knocking on every endpoint every morning. Default: 7
PRUNE_DAY=7

# Optional. Wall-clock cap on the sweep, as a `timeout` duration. Default: 25m
PRUNE_TIMEOUT=25m


# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Optional. Discord incoming webhook the ranked daily digest is posted to.
# Secret: a webhook URL is a write credential for that channel. Read by the CLI
# digest and the ingest path. Leave unset to skip notifications.
DISCORD_WEBHOOK_URL=

# Optional. The same thing for job_monitor.py's own scan notification, which
# reads this name (falling back to `discord_webhook` in companies.yaml).
DISCORD_WEBHOOK=


# ---------------------------------------------------------------------------
# Remote host and the local write API
# ---------------------------------------------------------------------------

# Optional. ssh target used by bin/jh and bin/jh-pull to run the CLI against
# the one database on the deployment host, rather than creating a second one
# locally.
JOB_HOST=deploy@example-host

# Optional. The checkout directory on that host, relative to its home.
# Default: job-hound
HOST_JOB_HOUND_DIR=job-hound

# Optional. Bearer token for the local write API (jobapi.py). Secret. Lives in
# the host environment file, never in the repo. The API binds to 127.0.0.1 only
# and is not exposed off the host.
JOB_API_TOKEN=

# Optional. Port for the local write API. Default: 8765
JOB_API_PORT=8765

# Optional. Python interpreter bin/daily.sh runs the stages with.
# Default: the repo's .venv/bin/python
PY=


# ---------------------------------------------------------------------------
# Read but not set here
# ---------------------------------------------------------------------------
# XDG_DATA_HOME and APPDATA are read only to locate the platform's per-user
# data directory for the scanner state file. Set JOB_MONITOR_STATE instead of
# changing either of them.
